# Copy to .env.local and fill in. Never commit real values.
NODE_ENV=development

# Runtime connection: a login role that is a member of app_role only (docs/runbooks/database-roles.md).
DATABASE_URL=
# Schema owner, used only by `pnpm db:migrate`.
DATABASE_URL_MIGRATOR=
# Isolation test suite only: a superuser on a throwaway database. The suite drops and rebuilds it.
DATABASE_URL_ADMIN=

# Better Auth: a random 32+ byte secret (e.g. `openssl rand -hex 32`) and the public app URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postmark (transactional email). Without these, non-production uses an in-memory mailer.
POSTMARK_SERVER_TOKEN=
MAIL_FROM=

# Inngest (background jobs). Required in production; the local dev server needs neither.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Vercel Blob (development storage; private blobs). Separate tokens per store are optional.
# Evidence must move to a write-once locked store before go-live (docs/PRD.md).
BLOB_READ_WRITE_TOKEN=
BLOB_DRAFTS_TOKEN=
BLOB_EVIDENCE_TOKEN=
