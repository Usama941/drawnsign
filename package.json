{
  "name": "drawnsign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolation": "vitest run --config vitest.isolation.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.14",
    "@cantoo/pdf-lib": "^2.11.1",
    "@peculiar/x509": "^3.1.0",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "@vercel/blob": "^2.8.2",
    "asn1js": "^4.0.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "~0.45.4",
    "inngest": "^4.26.2",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pkijs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "~0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsqr": "^1.4.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "smtp-server": "^3.21.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
