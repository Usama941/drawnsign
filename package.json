    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
